# 试点环境变量模板。复制为 docker/.env 后按需修改。
#   cp docker/.env.example docker/.env
#
# 生产请用 .env.prod.example，不要和这份混用。

MYSQL_ROOT_PASSWORD=wchabc123!!
MYSQL_PORT=3308

ADMIN_API_PORT=8081
STORE_API_PORT=8082
CLIENT_API_PORT=8083
ADMIN_WEB_PORT=8090
STORE_WEB_PORT=8091
H5_PORT=8092

# 须与宿主机 Nginx（nginx/host.conf）的域名一致
PLATFORM_BASE_DOMAIN=shop.test

APP_JAVA_OPTS="-Xms256m -Xmx1024m"
APP_MEM_LIMIT=1536m
JAVA_OPTS="-Xms128m -Xmx512m"
BACKEND_MEM_LIMIT=768m
SHOP_ROCKETMQ_ENABLED=false
