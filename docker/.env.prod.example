# 生产部署环境变量模板 —— 复制成 docker/.env 后逐项替换，.env 已在 .gitignore 中，不会被提交。
#
#   cp docker/.env.prod.example docker/.env
#
# 所有 CHANGE_ME 都必须改掉：compose 里这些变量写的是 ${VAR:?...} 形式，
# 缺失会直接中断 up，不会带着弱默认值上线。

# ---------- 必填：密钥与密码 ----------
# 数据库 root 密码
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
# Redis 访问密码
REDIS_PASSWORD=CHANGE_ME_redis_password
# JWT 签名密钥，建议 64 位以上随机串：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_64_chars_use__openssl_rand_base64_48
# 商户微信支付凭证的 AES-256-GCM 加密密钥，泄露等于所有租户收款凭证失守
# 生成：openssl rand -base64 32
AES_KEY=CHANGE_ME_aes_256_key_use__openssl_rand_base64_32
# XXL-Job 调度中心与执行器之间的通信 token，不设则任何人都能触发定时任务
XXL_JOB_ACCESS_TOKEN=CHANGE_ME_xxl_job_token

# ---------- 必填：域名与回调 ----------
# 平台基础域名，租户子域名在此之下分配（如 tenant1.shop.example.com）
PLATFORM_BASE_DOMAIN=shop.example.com
# 生产必须做真实 CNAME 检测；本地 docker compose 默认 skip
DOMAIN_SKIP_CNAME=false
# 商户后台展示的 H5 公网地址
H5_PUBLIC_URL=https://m.shop.example.com
# 微信支付回调基地址，必须公网可达且为 https，否则支付成功后订单状态永不更新
PAY_NOTIFY_BASE_URL=https://api.shop.example.com
# 正式环境保持 false；预发需要直接模拟支付时可临时设为 true
PAY_MOCK_ENABLED=false
# Let's Encrypt：默认关闭。打开前先把自定义域名 CNAME 到平台，并让 80 端口把
# /.well-known/acme-challenge/ 反代到 client-api。未打开时审核通过也不会假装已签发。
ACME_ENABLED=false
ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_EMAIL=
ACME_RELOAD_COMMAND=
# 商户后台公网地址，微信扫码授权完成后回跳到这里
STORE_CONSOLE_URL=https://store.shop.example.com

# ---------- 数据库 ----------
MYSQL_DATABASE=shop_platform
MYSQL_MAX_CONNECTIONS=500
# 消费者端连接池大小（压测结论：默认 10 在下单高并发下会排队）
CLIENT_DB_POOL_SIZE=50

# ---------- 端口映射（宿主机侧） ----------
ADMIN_API_PORT=8081
STORE_API_PORT=8082
CLIENT_API_PORT=8083
MP_API_PORT=8085
XXL_JOB_PORT=8180
ADMIN_WEB_PORT=8090
STORE_WEB_PORT=8091
H5_PORT=8092

# ---------- RocketMQ ----------
# broker 注册给客户端的地址。同 compose 网络内部可用服务名；
# 若有 compose 之外的客户端（例如宿主机进程或另一台机器）要连，必须改成宿主机内网 IP。
ROCKETMQ_BROKER_IP=rocketmq-broker

# ---------- JVM 堆（按机器内存调整，五个应用相加不要超过物理内存的 70%） ----------
ADMIN_JAVA_OPTS="-Xms512m -Xmx1g"
STORE_JAVA_OPTS="-Xms512m -Xmx1g"
CLIENT_JAVA_OPTS="-Xms1g -Xmx2g"
JOB_JAVA_OPTS="-Xms512m -Xmx1g"
MP_JAVA_OPTS="-Xms256m -Xmx512m"

# ---------- 其它 ----------
LOG_LEVEL=INFO
PAY_TIMEOUT_MINUTES=30
IMAGE_TAG=latest

# ---------- 基础镜像（内网/离线环境可改成私有仓库地址） ----------
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4
ROCKETMQ_IMAGE=apache/rocketmq:5.3.1
XXL_JOB_IMAGE=xuxueli/xxl-job-admin:2.4.2
MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
JRE_IMAGE=eclipse-temurin:17-jre
NODE_IMAGE=node:18-alpine
NGINX_IMAGE=nginx:alpine
