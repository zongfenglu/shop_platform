# 前端统一 Dockerfile —— admin/store 两个 Vue3 后台 + uniapp H5 打包方式一致。
# 靠 build arg APP_DIR / NGINX_CONF / BACKEND 区分。
#
# 用法（context 是仓库根目录）：
#   docker build -f docker/Dockerfile.frontend \
#     --build-arg APP_DIR=shop-ui/admin \
#     --build-arg NGINX_CONF=nginx/admin.conf \
#     --build-arg BACKEND=app:8080 \
#     -t shop/admin-web .

ARG NODE_IMAGE=node:18-alpine
ARG NGINX_IMAGE=nginx:alpine

# ---------- 构建阶段 ----------
FROM ${NODE_IMAGE} AS builder
ARG APP_DIR
ARG BUILD_CMD=build
WORKDIR /build

# 先拷 lockfile 装依赖，单独成层：改业务代码不会触发重新 npm install。
COPY ${APP_DIR}/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY ${APP_DIR}/ ./
RUN npm run ${BUILD_CMD}

# ---------- 运行阶段 ----------
FROM ${NGINX_IMAGE}
ARG NGINX_CONF
ARG BACKEND=app:8080
RUN apk add --no-cache curl tzdata \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo Asia/Shanghai > /etc/timezone
COPY docker/${NGINX_CONF} /tmp/nginx.conf
# 配置里的 __BACKEND__ 在构建时换成实际上游（试点一个 JVM，生产是拆开的 *-api）
RUN sed "s|__BACKEND__|${BACKEND}|g" /tmp/nginx.conf > /etc/nginx/conf.d/default.conf \
    && rm /tmp/nginx.conf
# Vue 后台打到 dist/；uni-app H5 打到 dist/build/h5，且资源用 /assets 绝对路径，必须铺到站点根。
COPY --from=builder /build/dist /tmp/dist
RUN if [ -d /tmp/dist/build/h5 ]; then \
      cp -a /tmp/dist/build/h5/. /usr/share/nginx/html/; \
    else \
      cp -a /tmp/dist/. /usr/share/nginx/html/; \
    fi \
    && rm -rf /tmp/dist
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -sf http://localhost/ >/dev/null || exit 1
